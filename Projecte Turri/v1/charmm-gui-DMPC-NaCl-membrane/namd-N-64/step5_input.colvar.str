###Lipid Head### 

Colvarstrajfrequency    100
Colvarsrestartfrequency 100

colvar {
   name dmpc_head_upper
   distanceZ {
      ref {
         dummyAtom ( 0.000, 0.000, 0.000 )
      }
      main {
         atomsFile      restraints/dmpc_head_upper.ref 
         atomsCol       B
         atomsColValue  1.0
      }
   }
}

harmonic {
   colvars dmpc_head_upper
   centers 17
   forceConstant $fc
}

colvar {
   name dmpc_head_lower
   distanceZ {
      ref {
         dummyAtom ( 0.000, 0.000, 0.000 )
      }
      main {
         atomsFile      restraints/dmpc_head_lower.ref 
         atomsCol       B
         atomsColValue  1.0
      }
   }
}

harmonic {
   colvars dmpc_head_lower
   centers -17
   forceConstant $fc
}


